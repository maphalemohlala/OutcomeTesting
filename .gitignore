# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# msbuild output directories
/bin
/obj

# nested .NET build outputs (plugin + registration projects)
plugins/**/bin/
plugins/**/obj/

# solution packaging scratch: exports, staging unpacks and packed zips
/artifacts

# MSBuild Binary and Structured Log
*.binlog

# secrets and local environment files (never commit)
.env
.env.*
*.secrets.json

# PAC local auth profiles and scratch
.auth/
.temp/

# NOTE: powerpages/ metadata IS version controlled. Do not ignore it.

# Plug-in signing key. It is a private key blob and it reproduces the PublicKeyToken the
# registration tool expects. The file must still exist here for the build - SignAssembly is
# on and the csproj names it - so a fresh clone cannot build until the key is supplied out
# of band.
plugins/OutcomeTesting.Plugins/OutcomeTesting.Plugins.snk

app/test-results/
test-results/
