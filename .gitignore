# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# msbuild output directories
/bin
/obj

# nested .NET build outputs (plugin + registration projects)
plugins/**/bin/
plugins/**/obj/

# solution packaging scratch: exports, staging unpacks and packed zips
/artifacts

# MSBuild Binary and Structured Log
*.binlog

# secrets and local environment files (never commit — see build guide 7.4)
.env
.env.*
*.secrets.json

# PAC local auth profiles and scratch
.auth/
.temp/

# Playwright MCP session artefacts (console logs, page snapshots) — scratch, not source
.playwright-mcp/

# NOTE: powerpages/ metadata IS version controlled. Do not ignore it.
