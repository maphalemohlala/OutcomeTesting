# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# msbuild output directories
/bin
/obj

# nested .NET build outputs (plugin + registration projects)
plugins/**/bin/
plugins/**/obj/

# solution packaging scratch: exports, staging unpacks and packed zips
/artifacts

# MSBuild Binary and Structured Log
*.binlog

# secrets and local environment files (never commit — see build guide 7.4)
.env
.env.*
*.secrets.json

# PAC local auth profiles and scratch
.auth/
.temp/

# Playwright MCP session artefacts (console logs, page snapshots) — scratch, not source
.playwright-mcp/

# NOTE: powerpages/ metadata IS version controlled. Do not ignore it.

# Claude Code personal settings (machine-specific paths)
.claude/settings.local.json

# vendored obra/superpowers skills - installed locally, not committed
/.github/skills/

# Plug-in signing key (OD-025). Untracked 2026-09-08: it is a private key blob and it
# reproduces the PublicKeyToken the registration tool expects. The file must still exist
# here for the build - SignAssembly is on and the csproj names it - so a fresh clone
# cannot build until the key is supplied out of band. That is the gap Key Vault injection
# at build time is meant to close.
plugins/OutcomeTesting.Plugins/OutcomeTesting.Plugins.snk
