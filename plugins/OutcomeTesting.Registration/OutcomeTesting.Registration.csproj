<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!--
      This machine carries only the .NET 10 runtime, and without a roll-forward policy the
      built exe refuses to start: "You must install or update .NET to run this application",
      which reads like a missing SDK rather than a missing runtime *major* and cost real time
      on 2026-09-04. Rolling forward keeps the tested target framework — the Dataverse client
      is validated against net8.0 — while letting the tool run on whatever major is actually
      installed. Prefer this over retargeting, which would change what the client is tested on.
    -->
    <RollForward>LatestMajor</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OutcomeTesting.Registration</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" Version="1.*" />
  </ItemGroup>

  <!--
    The notification copy is LINKED from the plug-in project rather than copied here, and a
    project reference is not an option: the plug-ins target net462 and this tool targets
    net8.0.

    It has to be one file. The whole point of the template table is that the wording lives in
    one place; a seed verb carrying its own transcription of the same letters would be a
    second copy, drifting from the fallback the moment either was edited - and the drift would
    surface as an environment whose seeded rows quietly disagree with what it sends when those
    rows are missing.

    NotificationTemplates depends only on Microsoft.Xrm.Sdk types, which the Dataverse client
    package supplies here too.
  -->
  <ItemGroup>
    <Compile Include="..\OutcomeTesting.Plugins\NotificationTemplates.cs"
             Link="Linked\NotificationTemplates.cs" />
  </ItemGroup>

  <!--
    The letter's documents, linked for the same reason: `renderpdf` draws a case's PDFs with
    exactly the code the plug-in runs, so two environments' output can be compared without a
    submission in either.
  -->
  <ItemGroup>
    <Compile Include="..\OutcomeTesting.Plugins\CompletedCheckPdf.cs" Link="Linked\CompletedCheckPdf.cs" />
    <Compile Include="..\OutcomeTesting.Plugins\CompletedCheck.cs" Link="Linked\CompletedCheck.cs" />
    <Compile Include="..\OutcomeTesting.Plugins\RemediationDocument.cs" Link="Linked\RemediationDocument.cs" />
    <Compile Include="..\OutcomeTesting.Plugins\PdfWriter.cs" Link="Linked\PdfWriter.cs" />
    <Compile Include="..\OutcomeTesting.Plugins\ChecklistDocument.cs" Link="Linked\ChecklistDocument.cs" />
    <Compile Include="..\OutcomeTesting.Plugins\OptionLabels.cs" Link="Linked\OptionLabels.cs" />
    <Compile Include="..\OutcomeTesting.Plugins\CommandHelpers.cs" Link="Linked\CommandHelpers.cs" />
    <Compile Include="..\OutcomeTesting.Plugins\OutcomeRules.cs" Link="Linked\OutcomeRules.cs" />
    <Compile Include="..\OutcomeTesting.Plugins\CaseLifecycle.cs" Link="Linked\CaseLifecycle.cs" />
    <Compile Include="..\OutcomeTesting.Plugins\CaseHeaderRules.cs" Link="Linked\CaseHeaderRules.cs" />
    <Compile Include="..\OutcomeTesting.Plugins\GradingRules.cs" Link="Linked\GradingRules.cs" />
    <Compile Include="..\OutcomeTesting.Plugins\ResponseRules.cs" Link="Linked\ResponseRules.cs" />
    <Compile Include="..\OutcomeTesting.Plugins\SectionRules.cs" Link="Linked\SectionRules.cs" />
  </ItemGroup>

</Project>
